#!/bin/sh
# Avvia lo schermo virtuale del bot e lo rende visibile all'app.
# Ogni pezzo viene riavviato da solo se si chiude.
export DISPLAY=:1
tieni_vivo() { while true; do "$@" >/dev/null 2>&1; sleep 1; done; }

# icona di Chromium per la barra (si trova dentro la cartella del browser)
LOGO=$(ls /opt/pw-browsers/chromium-*/chrome-linux*/product_logo_48.png 2>/dev/null | tail -1)
[ -n "$LOGO" ] && cp "$LOGO" /usr/share/pixmaps/chromium.png 2>/dev/null

rm -f /tmp/.X1-lock /tmp/.X11-unix/X1
tieni_vivo Xvfb :1 -screen 0 1280x800x24 -nolisten tcp &
for _ in $(seq 1 50); do xdpyinfo >/dev/null 2>&1 && break; sleep 0.1; done
tieni_vivo openbox &
(sleep 2; xsetroot -solid "#0e0e10") &
tieni_vivo tint2 &
tieni_vivo x11vnc -display :1 -forever -shared -nopw -localhost -rfbport 5900 -quiet &
tieni_vivo websockify 127.0.0.1:6080 127.0.0.1:5900 &
wait
